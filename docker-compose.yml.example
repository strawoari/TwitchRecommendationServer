version: '3.8'


services:
  db:
    image: mysql:latest
    environment:
      MYSQL_ROOT_HOST: '%'
      MYSQL_DATABASE: database
      MYSQL_ROOT_PASSWORD: password
      TZ: UTC
    volumes:
      - mysql-local:/var/lib/mysql
    ports:
      - 3307:3306


# permanent storage of data.
volumes:
  mysql-local:
